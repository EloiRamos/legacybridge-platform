# Non-secret configuration (copy to .env). Secrets are files under deploy/secrets/ (make secrets), mounted as Docker
# secrets: the HALDEN credential is deploy/secrets/halden_secret.txt (never an environment value).
# Every active line below is consumed by compose.yaml; the values shown are compose's own defaults.
LBF_PROFILE=default
LBF_PUBLIC_ORIGIN=http://127.0.0.1:8080
# MUST be true behind TLS; false only for the loopback-HTTP reference deployment.
LBF_COOKIE_SECURE=false
# HALDEN base URL and client timeout (the test profile uses http://wiretap:8090 and 1).
LBF_HALDEN_URL=http://halden:8090
LBF_TRANSPORT_TIMEOUT_SEC=5
# The SKARVIK exchange directory is fixed at /exchange inside the containers (shared volume lbf-skarvik-exchange).
# Assistant: disabled | scripted | openai. compose.yaml pins LBF_LIVE_INFERENCE=false, so no live call is possible
# under compose; enabling one is an owner decision (ADR-F10). The key belongs in deploy/secrets/openai_api_key.txt.
LBF_ASSISTANT_PROVIDER=disabled
# Used only by the openai provider; no other value is accepted.
OPENAI_MODEL=gpt-6-luna
# Read by the application only when it runs outside compose.yaml (not passed by compose; live inference is off):
# LBF_LIVE_INFERENCE=false
# LBF_OPENAI_INPUT_PRICE_PER_MTOK=
# LBF_OPENAI_CACHED_INPUT_PRICE_PER_MTOK=
# LBF_OPENAI_OUTPUT_PRICE_PER_MTOK=
# LBF_OPENAI_PRICE_SOURCE=
# LBF_OPENAI_PRICE_OBSERVED_AT=
